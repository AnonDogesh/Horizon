<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E110C"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp">

    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_back"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#E6ECD7" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_private_vault"
                android:textColor="#E6ECD7"
                android:textSize="35sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vault_subtitle"
                android:textColor="#7E8A6D"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/buttonSearch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/action_search"
            android:src="@android:drawable/ic_menu_search"
            android:tint="#E6ECD7" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/vaultTabLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerRow"
        app:tabIndicatorColor="#AAB58A"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="#AAB58A"
        app:tabTextColor="#7E8A6D" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vaultRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vaultTabLayout" />

    <TextView
        android:id="@+id/textEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/vault_empty_state"
        android:textColor="#7E8A6D"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/vaultRecyclerView"
        app:layout_constraintEnd_toEndOf="@id/vaultRecyclerView"
        app:layout_constraintStart_toStartOf="@id/vaultRecyclerView"
        app:layout_constraintTop_toTopOf="@id/vaultRecyclerView" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/buttonAddFile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="@string/action_add_file"
        app:backgroundTint="#B8C58A"
        app:layout_constraintBottom_toBottomOf="@id/vaultRecyclerView"
        app:layout_constraintEnd_toEndOf="@id/vaultRecyclerView"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="#10140F" />

</androidx.constraintlayout.widget.ConstraintLayout>
