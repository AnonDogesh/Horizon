<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#1A2117"
    app:cardCornerRadius="18dp"
    app:strokeColor="#263024"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/filePreview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/documentOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_vault_document"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/filePreview"
            app:layout_constraintEnd_toEndOf="@id/filePreview"
            app:layout_constraintStart_toStartOf="@id/filePreview"
            app:layout_constraintTop_toTopOf="@id/filePreview">

            <ImageView
                android:id="@+id/fileTypeIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/app_name"
                android:tint="#DCE6BF" />

            <TextView
                android:id="@+id/fileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#E6ECD7"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/videoBadge"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_vault_video_badge"
            android:contentDescription="@string/vault_video_content"
            android:padding="16dp"
            android:src="@android:drawable/ic_media_play"
            android:tint="#11140F"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/filePreview"
            app:layout_constraintEnd_toEndOf="@id/filePreview"
            app:layout_constraintStart_toStartOf="@id/filePreview"
            app:layout_constraintTop_toTopOf="@id/filePreview" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
